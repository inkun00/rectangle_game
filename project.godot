; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but since it can be edited, this one goes through all the basics.

config_version=5

[application]

config/name="Quadrilateral World"
config/description="사각형으로 그림을 그리고, 집을 짓고, 나만의 친구와 떠나는 수학 모험"
config/icon="res://assets/generated/revision/app-icon.png"
run/main_scene="res://scenes/main/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/show_image=false
boot_splash/bg_color=Color(0.973, 0.98, 0.965, 1)
boot_splash/fullsize=false
boot_splash/use_filter=false

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/resizable=true
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.web="gl_compatibility"

[gui]

theme/custom_font="res://assets/fonts/korean_font.ttf"

[input_devices]

pointing/emulate_mouse_from_touch=true
