; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but since it can be edited, this one goes through all the basics.

config_version=5

[application]

; The project name is part of the existing user:// save directory.
config/name="Quadrilateral World"
config/name_localized={"en": "사각이의 모험", "ko": "사각이의 모험"}
config/description="사각형으로 그림을 그리고, 집을 짓고, 사각이와 떠나는 수학 모험"
config/icon="res://assets/generated/starfront-v1/app-icon.webp"
run/main_scene="res://scenes/main/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/show_image=false
boot_splash/bg_color=Color(0.067, 0.11, 0.161, 1)
boot_splash/fullsize=false
boot_splash/use_filter=false

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/resizable=true
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.web="gl_compatibility"
textures/webp_compression/compression_method=4
textures/webp_compression/lossless_compression_factor=100.0

[gui]

theme/custom_font="res://assets/fonts/korean_font.ttf"

[input_devices]

pointing/emulate_mouse_from_touch=true
