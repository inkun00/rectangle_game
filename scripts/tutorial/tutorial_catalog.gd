class_name TutorialCatalog
extends RefCounted

## Original short conversations about the existing controls, separate from lessons.
const MODE_IDS: Array[String] = ["learning", "drawing", "masterpiece", "construction", "my_house", "workshop", "world"]

static func title(mode: String) -> String:
	match mode:
		"learning": return "수학 직접 해 보기 안내"
		"drawing": return "자유 그림 안내"
		"masterpiece": return "명화 채우기 안내"
		"construction": return "부탁받은 집 짓기 안내"
		"my_house": return "나만의 집 짓기 안내"
		"workshop": return "캐릭터 공방 안내"
		"world": return "마을 주민 심부름하기 안내"
	return ""

static func steps(mode: String) -> Array[Dictionary]:
	match mode:
		"learning":
			return [
				_step("안녕! 안내원 직각이야. 선과 도형을 직접 움직이며 함께 살펴보자.", "지금 활동의 목표를 읽어 봐요."),
				_step("먼저 ‘재어 보기’를 눌러 보자. 눈으로 짐작한 것과 재어 본 결과를 비교할 수 있어.", "재어 보기를 한 번 눌러요.", "learning_measure"),
				_step("파란 점이나 조절 버튼을 움직여 봐. 도형을 고르는 활동에서는 도형을 눌러 선택하면 돼.", "선의 위치나 도형 선택을 바꿔 봐요.", "learning_adjust"),
				_step("이제 ‘확인하기’를 눌러 보자. 지금 생각한 방법에 어떤 설명이 나오는지 살펴보는 거야.", "확인하기를 눌러 설명을 읽어요.", "learning_check"),
				_step("다른 설명이 나와도 괜찮아. 길이와 각을 다시 살펴보고, 까닭을 고르는 단계까지 천천히 이어 가자.", "결과의 설명을 읽고 다음 생각을 정해요."),
				_step("도형을 돌려 놓아도 변의 길이와 각의 크기는 그대로야. 생김새만 보지 말고 성질을 확인해 보자!", "내가 고른 까닭을 말해 봐요.")
			]
		"drawing":
			return [
				_step("여기는 사각형으로 그림을 만드는 종이야. 네가 고른 색과 도형으로 자유롭게 꾸며 보자.", "만들고 싶은 그림을 떠올려요."),
				_step("도형을 고른 뒤 종이에서 드래그해 봐. ‘가운데에 도형 추가’를 눌러도 도형을 놓을 수 있어.", "종이에 도형을 하나 놓아요.", "drawing_add"),
				_step("‘선택·이동’으로 도형을 잡아 옮겨 봐. 변과 꼭짓점의 손잡이는 크기, 둥근 손잡이는 방향을 바꾸는 데 써.", "선택한 도형을 옮기거나 크기·방향을 바꿔요.", "drawing_edit"),
				_step("바꾸기 전 모습도 다시 볼까? ‘되돌리기’를 누르면 방금 한 편집을 한 번 되돌릴 수 있어.", "되돌리기를 한 번 눌러요.", "drawing_undo"),
				_step("‘다시’를 누르면 되돌렸던 편집을 다시 적용할 수 있어. 마음에 드는 배치를 천천히 찾아보자.", "편집 버튼의 역할을 알아봐요."),
				_step("배경과 색도 골라 봐. 그림은 자동으로 저장되고, 원할 때 ‘PNG 저장’으로 작품을 간직할 수 있어.", "나만의 그림을 자유롭게 이어 그려요.")
			]
		"masterpiece":
			return [
				_step("명화 밑그림에서 새로운 그림의 아이디어를 찾아보자. 다섯 가지 사각형으로 네 방식대로 표현하면 돼.", "마음에 드는 밑그림을 찾아요."),
				_step("‘명화 채우기’나 ‘명화 10종 고르기’에서 원하는 밑그림을 골라 봐. 이미 골랐다면 그 그림에서 이어 가자.", "밑그림을 하나 골라요.", "masterpiece_chosen"),
				_step("밑그림을 켜고 끄거나 진하기를 바꿔 봐. 작은 화면에서는 ‘편집 더 보기’에서도 바꿀 수 있어.", "밑그림의 표시나 진하기를 바꿔요.", "masterpiece_guide"),
				_step("밑그림에서 표현하고 싶은 부분에 사각형을 놓아 보자. 종이에서 드래그하거나 ‘가운데에 도형 추가’를 눌러도 돼.", "밑그림 위에 사각형을 하나 놓아요.", "drawing_add"),
				_step("밑그림에서 사각형으로 나타내고 싶은 부분을 찾아보자. 색이나 도형의 크기는 네가 정해도 좋아.", "어떤 부분을 사각형으로 표현할지 정해요."),
				_step("직사각형은 네 각이 모두 직각이고, 마름모는 네 변의 길이가 같아. 표현할 부분에 어울리는 성질을 골라 보자.", "도형의 변과 각을 살피며 그림을 만들어요."),
				_step("밑그림을 잠깐 끄면 네가 만든 도형만 살펴볼 수 있어. 정해진 점수 없이 너만의 작품을 이어 가자!", "내가 만든 도형과 색을 감상해요.")
			]
		"construction":
			return [
				_step("집을 부탁한 손님이 기다리고 있어. 먼저 어떤 집을 바라는지 함께 읽어 보자.", "부탁 카드에서 꼭 필요한 조건을 찾아요."),
				_step("강조된 부탁 버튼을 눌러 보자. ‘의뢰서 보기’가 나오면 들어가서 조건을 읽고 ‘부탁 받고 집 짓기’로 시작하면 돼.", "부탁을 읽고 집 짓기를 시작해요.", "construction_accept"),
				_step("쓸 수 있는 재료를 골라 도면에 놓아 보자. 첫 집 안내의 ‘안내대로 놓기’를 이용해도 좋아.", "도면에 재료를 하나 놓아요.", "construction_place"),
				_step("문과 창 위에는 가로 받침이 필요해. 문이나 유리 자체로 지붕을 받치지 않도록 배치를 살펴보자.", "문·창과 받침의 자리를 살펴봐요."),
				_step("‘튼튼한지 확인’을 눌러 보자. 검사에서는 떠 있거나 기울어지는 재료가 있는지 살펴볼 수 있어.", "집의 튼튼함을 한 번 확인해요.", "construction_inspect"),
				_step("검사 결과에서 고칠 곳과 까닭을 읽어 보자. 설계 원본은 보관되니 돌아가서 배치를 고칠 수 있어.", "검사 결과가 알려 주는 까닭을 읽어요."),
				_step("부탁 조건과 튼튼함을 모두 살펴본 뒤 집을 보여 주면 돼. 첫 집 안내는 한 가지 예시이니 다른 모습으로 지어도 좋아!", "내 설계로 집 짓기를 이어 가요.")
			]
		"my_house":
			return [
				_step("여기는 네가 살고 싶은 집을 만드는 곳이야. 어떤 문과 창, 지붕을 쓰고 싶은지 떠올려 보자.", "나만의 집 모습을 생각해 봐요."),
				_step("부탁받은 집과 나만의 집은 따로 보관돼. 지금 쓸 수 있는 재료와 자산을 확인하며 천천히 설계하자.", "재료와 남은 자산을 살펴봐요."),
				_step("쓸 수 있는 재료를 골라 원하는 자리에 놓아 봐. 처음부터 집 전체를 완성할 필요는 없어.", "나만의 집에 재료를 하나 놓아요.", "my_house_place"),
				_step("‘재료 보기’를 눌러 집의 모습을 살펴보자. 재료를 다시 배치하고 싶으면 ‘설계 보기’로 돌아오면 돼.", "재료 보기를 눌러 설계와 비교해요.", "my_house_view"),
				_step("재료의 위치와 방향을 바꾸며 어울리는 배치를 찾아봐. 회전해도 선택한 사각형의 성질은 그대로야.", "변과 각을 살피며 집을 꾸며요."),
				_step("네가 만든 집은 계속 이어 지을 수 있어. 마음에 드는 모습이 되면 원하는 때에 그림으로 저장해도 좋아.", "나만의 집을 자유롭게 이어 지어요.")
			]
		"workshop":
			return [
				_step("사각형 캐릭터 그림을 직접 만들어 보자. 골격의 빈칸마다 네가 고른 사각형을 놓으면 돼.", "캐릭터의 골격과 빈칸을 살펴봐요."),
				_step("도형을 고르고 빈 골격 칸을 눌러 봐. ‘색칠된 예시 사용’을 눌러 완성된 모습을 먼저 살펴봐도 좋아.", "골격에 사각형을 하나 놓아요.", "workshop_place"),
				_step("색과 크기, 방향을 바꾸어 너만의 친구로 꾸며 봐. 돌려도 선택한 사각형의 종류는 바뀌지 않아.", "친구에게 어울리는 색과 도형을 골라요."),
				_step("이제 남은 골격 칸도 채워 보자. 예시를 이용해도 괜찮아.", "모든 골격 칸을 채워요.", "workshop_ready"),
				_step("미리 보기에서 네가 만든 친구를 살펴봐. 고치고 싶은 곳이 있으면 원하는 도형을 골라 바꿔 보자.", "완성한 친구의 모습을 살펴봐요."),
				_step("완성한 캐릭터 그림은 PNG로 저장할 수 있어. 마을의 주인공과 함께 심부름하러 갈 수도 있어!", "그림을 간직하거나 마을로 이동해요.")
			]
		"world":
			return [
				_step("사각형 친구와 마을을 돌아다니며 주민들의 부탁을 들어주자. 먼저 가까운 곳에서 움직이는 방법부터 익혀 보자.", "주변의 길과 발판을 살펴봐요."),
				_step("A·D나 왼쪽·오른쪽 방향키로 걸어 봐. 화면 이동 버튼을 켰다면 그 버튼을 사용해도 돼.", "길을 따라 조금 걸어 보아요.", "world_move"),
				_step("Space나 위쪽 방향키로 뛰어 보자. 화면의 점프 버튼도 같은 역할을 해.", "점프를 한 번 해 봐요.", "world_jump"),
				_step("I나 가방 버튼으로 가진 물건을 살펴보자. 확인한 뒤 닫기나 Esc로 돌아오면 돼.", "가방을 열어 보고 닫아요.", "world_inventory"),
				_step("J나 부탁 수첩 버튼을 눌러 봐. 주민의 부탁과 진행 상황을 확인하고, 닫은 뒤 다시 만나자.", "부탁 수첩을 열어 보고 닫아요.", "world_journal"),
				_step("가까운 물건은 G로 주울 수 있고, 가까이 닿아도 모을 수 있어. 위쪽 물건은 발판에 올라가 찾아봐.", "주변 물건과 발판을 찾아봐요."),
				_step("주민 앞에서 E로 이야기를 나눠 봐. 물건을 모으고 사각형 문제를 풀면 집과 우주선에 쓸 돈을 받아.", "만나고 싶은 주민을 찾아봐요."),
				_step("천천히 탐험하고 싶다면 메뉴의 ‘편안한 탐험’을 켜도 좋아. 이 안내는 도움말에서 언제든 다시 볼 수 있어!", "내 속도로 심부름을 이어 가요.")
			]
	return []

static func _step(text: String, goal: String, event: String = "") -> Dictionary:
	return {"speaker": "안내원 직각이", "text": text, "goal": goal, "event": event, "target": event, "portrait": 3}
