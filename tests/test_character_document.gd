class_name TestCharacterDocument
extends RefCounted

const Document = preload("res://scripts/core/character_document.gd")
const Templates = preload("res://scripts/core/character_templates.gd")
const Math = preload("res://scripts/core/quadrilateral_math.gd")

static func run(t) -> void:
	var document: Document = Document.new()
	t.assert_eq(document.shapes.size(), 0, "New character starts with an empty skeleton")
	t.assert_false(document.completion().ready, "An empty skeleton cannot enter the world")
	t.assert_false(document.fill_slot("head", "square", Color.RED), "Wrong named shape cannot fill rectangle slot")
	t.assert_eq(document.shapes.size(), 0, "Wrong shape leaves document unchanged")
	t.assert_true(document.fill_slot("head", "rectangle", Color.RED), "Matching shape fills skeleton slot")
	t.assert_true(document.can_undo(), "Fill creates undo command")
	document.undo()
	t.assert_eq(document.shapes.size(), 0, "Undo removes filled part")
	document.redo()
	t.assert_eq(document.shapes.size(), 1, "Redo restores filled part")
	var original: Dictionary = document.get_selected()
	document.move_selected(Vector2(160, 10))
	t.assert_eq(document.completion().filled, 0, "A part moved away no longer fills skeleton")
	document.undo()
	t.assert_eq(document.get_selected().position, original.position, "Undo restores original local placement")
	document.rotate_selected(37.0)
	document.scale_selected(1.25)
	t.assert_true(Math.matches_kind(document.get_selected().vertices, "rectangle"), "Geometry transforms preserve rectangle constraints")
	document.set_color(Color.BLUE)
	document.undo()
	t.assert_eq(document.get_selected().color, Color.RED, "Color change is undoable")
	document.duplicate_selected()
	t.assert_eq(document.shapes.size(), 2, "Duplicate creates independent shape")
	t.assert_eq(document.get_selected().slot_id, "", "Duplicate does not claim same skeleton slot")
	document.delete_selected()
	t.assert_eq(document.shapes.size(), 1, "Delete removes selected duplicate")
	document.fill_example()
	t.assert_true(document.completion().ready, "Example assembles a playable character")
	t.assert_eq(document.completion().filled, 12, "Robot has twelve fitted parts")
	var serialized: Dictionary = document.serialize()
	var json_result: Variant = JSON.parse_string(JSON.stringify(serialized))
	t.assert_true(json_result is Dictionary, "Document serializes to portable JSON")
	var restored: Document = Document.new()
	t.assert_true(restored.restore(json_result), "Valid JSON restores all typed geometry")
	t.assert_true(restored.completion().ready, "Restored character remains playable")
	t.assert_eq(restored.shapes.size(), document.shapes.size(), "Restore preserves every authored part")
	var bad: Dictionary = serialized.duplicate(true)
	bad.shapes[0].vertices = [[0, 0], [10, 0], [20, 0], [30, 0]]
	var before: String = JSON.stringify(restored.serialize())
	t.assert_false(restored.restore(bad), "Corrupt collinear save rejected")
	t.assert_eq(JSON.stringify(restored.serialize()), before, "Corrupt restore is atomic")
	bad = serialized.duplicate(true)
	bad.shapes[1].id = bad.shapes[0].id
	t.assert_false(restored.restore(bad), "Duplicate shape IDs rejected")
	bad = serialized.duplicate(true)
	bad.shapes[0].kind = "square"
	t.assert_false(restored.restore(bad), "Mislabeled geometry rejected")
	bad = serialized.duplicate(true)
	bad.shapes[0].position = ["not a number", 0]
	t.assert_false(restored.restore(bad), "Invalid coordinate type rejected")
	bad = serialized.duplicate(true)
	bad.template_id = "unknown"
	t.assert_false(restored.restore(bad), "Unknown template rejected")
	document.clear()
	t.assert_eq(document.shapes.size(), 0, "Clear removes all artwork")
	document.undo()
	t.assert_true(document.completion().ready, "Clear is undoable")
	document.set_template("cat")
	t.assert_eq(document.shapes.size(), 0, "Changing template starts new skeleton")
	document.undo()
	t.assert_eq(document.template_id, "robot", "Template change is undoable")
	t.assert_true(document.completion().ready, "Undo template change restores artwork")
	document.redo()
	t.assert_eq(document.template_id, "cat", "Redo reapplies template change")
	for template: Dictionary in Templates.all_templates():
		var sample: Document = Document.new()
		sample.set_template(str(template.id))
		sample.fill_example()
		t.assert_true(sample.completion().ready, "Each example forms a ready articulated character")
		var first_slot: Dictionary = template.parts[0]
		var shape: Dictionary = sample.shape_for_slot(str(first_slot.id))
		sample.select_shape(int(shape.id))
		sample.move_selected(Vector2(400, 400))
		t.assert_false(sample.completion().ready, "Displaced part invalidates readiness")
		t.assert_true(sample.attach_selected(str(first_slot.id)), "Part snaps back onto skeleton")
		t.assert_true(sample.completion().ready, "Snapping restores readiness")
	t.assert_eq(document.add_shape("triangle", Vector2.ZERO, Color.WHITE), -1, "Unsupported free shape rejected")
	t.assert_eq(document.add_shape("square", Vector2(INF, 0), Color.WHITE), -1, "Nonfinite position rejected")
	_test_right_trapezoid_parts(t)
	_test_repair_after_edit(t)

static func _test_repair_after_edit(t: Node) -> void:
	var document: Document = Document.new()
	document.fill_slot("body", "trapezoid", Color.CORAL, "right_right")
	document.rotate_selected(17.0)
	var original_body: Dictionary = document.get_selected()
	document.scale_selected(0.35)
	document.move_selected(Vector2(140, 80))
	document.fill_slot("chest", "rhombus", Color.GOLD)
	document.add_shape("square", Vector2(220, 30), Color.BLUE)
	var displaced: Dictionary = document.serialize()
	var restored: Document = Document.new()
	t.assert_true(restored.restore(JSON.parse_string(JSON.stringify(displaced))), "A displaced part can be repaired after reopening its save")
	var reopened: Dictionary = restored.serialize()
	t.assert_true(restored.fill_slot("body", "trapezoid", Color.CORAL), "A displaced part in a legacy document can be refitted")
	t.assert_eq(restored.completion().filled, 2, "Refitting completes the saved part")
	var fitted: Dictionary = restored.get_selected()
	t.assert_eq(fitted.id, original_body.id, "Refitting reuses the authored part")
	t.assert_eq(fitted.color, Color.CORAL, "Refitting retains the authored paint")
	t.assert_eq(Math.trapezoid_variant(fitted.vertices), "right_right", "Refitting retains the chosen trapezoid variant")
	var original_edge: Vector2 = original_body.vertices[1] - original_body.vertices[0]
	var fitted_edge: Vector2 = fitted.vertices[1] - fitted.vertices[0]
	t.assert_true(original_edge.normalized().is_equal_approx(fitted_edge.normalized()), "Refitting a resized part retains its rotation")
	restored.undo()
	t.assert_eq(restored.serialize(), reopened, "One undo restores the displaced part, decorations and selection")
	restored.fill_example()
	t.assert_true(restored.completion().ready, "Colored example repairs displaced parts and fills missing slots")
	t.assert_eq(restored.shapes.size(), 13, "Example keeps the decoration and one of each robot part")
	var ready: Dictionary = restored.serialize()
	restored.undo()
	t.assert_eq(restored.serialize(), reopened, "One undo reverses the whole example repair")
	restored.redo()
	t.assert_eq(restored.serialize(), ready, "Redo restores the playable character and its decorations")

static func _test_right_trapezoid_parts(t: Node) -> void:
	for template: Dictionary in Templates.all_templates():
		for variant: String in ["right_left", "right_right"]:
			var document: Document = Document.new()
			document.set_template(str(template.id))
			var target_slot: String = ""
			for slot: Dictionary in template.parts:
				if str(slot.kind) == "trapezoid":
					t.assert_true(document.fill_slot(str(slot.id), "trapezoid", Color.CORAL, variant), "Both right trapezoids can fill matching skeleton slots")
					target_slot = str(slot.id)
			document.fill_example()
			t.assert_true(document.completion().ready, "Right trapezoid parts form a playable character for every template")
			var shape: Dictionary = document.shape_for_slot(target_slot)
			t.assert_eq(Math.trapezoid_variant(shape.vertices), variant, "Filling the example preserves already authored right trapezoids")
			document.select_shape(int(shape.id))
			document.rotate_selected(37.0)
			document.scale_selected(1.1)
			t.assert_true(document.attach_selected(target_slot), "Rotated right trapezoid snaps back to its matching skeleton")
			t.assert_eq(Math.trapezoid_variant(document.get_selected().vertices), variant, "Snapping preserves the two right angles on the chosen side")
			t.assert_true(document.completion().ready, "Snapped right trapezoid still completes the character")
			var snapshot: Dictionary = document.serialize()
			var restored: Document = Document.new()
			t.assert_true(restored.restore(JSON.parse_string(JSON.stringify(snapshot))), "Characters with right trapezoids survive the existing v1 save format")
			t.assert_eq(restored.serialize(), snapshot, "Save round trip preserves ordered vertices, positions and colors")
			document.undo()
			t.assert_eq(Math.trapezoid_variant(document.get_selected().vertices), variant, "Undo snapping preserves right trapezoid geometry")
			document.redo()
			t.assert_eq(document.serialize(), snapshot, "Redo snapping restores the complete character")
	var free_document: Document = Document.new()
	var id: int = free_document.add_shape("trapezoid", Vector2(240, 0), Color.TEAL, "right_right")
	t.assert_gt(id, 0, "Free workshop decorations support right trapezoids")
	t.assert_eq(Math.trapezoid_variant(free_document.get_selected().vertices), "right_right", "Free creation uses chosen subtype")
	var before: Dictionary = free_document.serialize()
	t.assert_eq(free_document.add_shape("trapezoid", Vector2.ZERO, Color.RED, "invalid"), -1, "Invalid subtype cannot add empty character geometry")
	t.assert_false(free_document.fill_slot("body", "trapezoid", Color.RED, "invalid"), "Invalid subtype cannot fill a skeleton")
	t.assert_eq(free_document.serialize(), before, "Rejected subtype leaves artwork and selection intact")
