class_name TestCharacterDocument
extends RefCounted

const Document = preload("res://scripts/core/character_document.gd")
const Templates = preload("res://scripts/core/character_templates.gd")
const Math = preload("res://scripts/core/quadrilateral_math.gd")
const Workshop = preload("res://scenes/workshop/character_workshop.gd")

static func run(t) -> void:
	var document: Document = Document.new()
	t.assert_eq(document.shapes.size(), 0, "New character starts with an empty skeleton")
	t.assert_false(document.completion().ready, "An empty skeleton cannot enter the world")
	t.assert_false(document.fill_slot("head", "square", Color.RED), "Wrong named shape cannot fill rectangle slot")
	t.assert_eq(document.shapes.size(), 0, "Wrong shape leaves document unchanged")
	t.assert_true(document.fill_slot("head", "rectangle", Color.RED), "Matching shape fills skeleton slot")
	t.assert_true(document.can_undo(), "Fill creates undo command")
	document.undo()
	t.assert_eq(document.shapes.size(), 0, "Undo removes filled part")
	document.redo()
	t.assert_eq(document.shapes.size(), 1, "Redo restores filled part")
	var original: Dictionary = document.get_selected()
	document.move_selected(Vector2(160, 10))
	t.assert_eq(document.completion().filled, 0, "A part moved away no longer fills skeleton")
	document.undo()
	t.assert_eq(document.get_selected().position, original.position, "Undo restores original local placement")
	document.rotate_selected(37.0)
	document.scale_selected(1.25)
	t.assert_true(Math.matches_kind(document.get_selected().vertices, "rectangle"), "Geometry transforms preserve rectangle constraints")
	document.set_color(Color.BLUE)
	document.undo()
	t.assert_eq(document.get_selected().color, Color.RED, "Color change is undoable")
	document.duplicate_selected()
	t.assert_eq(document.shapes.size(), 2, "Duplicate creates independent shape")
	t.assert_eq(document.get_selected().slot_id, "", "Duplicate does not claim same skeleton slot")
	document.delete_selected()
	t.assert_eq(document.shapes.size(), 1, "Delete removes selected duplicate")
	document.fill_example()
	t.assert_true(document.completion().ready, "Example assembles a playable character")
	t.assert_eq(document.completion().filled, 12, "Robot has twelve fitted parts")
	var serialized: Dictionary = document.serialize()
	var json_result: Variant = JSON.parse_string(JSON.stringify(serialized))
	t.assert_true(json_result is Dictionary, "Document serializes to portable JSON")
	var restored: Document = Document.new()
	t.assert_true(restored.restore(json_result), "Valid JSON restores all typed geometry")
	t.assert_true(restored.completion().ready, "Restored character remains playable")
	t.assert_eq(restored.shapes.size(), document.shapes.size(), "Restore preserves every authored part")
	var bad: Dictionary = serialized.duplicate(true)
	bad.shapes[0].vertices = [[0, 0], [10, 0], [20, 0], [30, 0]]
	var before: String = JSON.stringify(restored.serialize())
	t.assert_false(restored.restore(bad), "Corrupt collinear save rejected")
	t.assert_eq(JSON.stringify(restored.serialize()), before, "Corrupt restore is atomic")
	bad = serialized.duplicate(true)
	bad.shapes[1].id = bad.shapes[0].id
	t.assert_false(restored.restore(bad), "Duplicate shape IDs rejected")
	bad = serialized.duplicate(true)
	bad.shapes[0].kind = "square"
	t.assert_false(restored.restore(bad), "Mislabeled geometry rejected")
	bad = serialized.duplicate(true)
	bad.shapes[0].position = ["not a number", 0]
	t.assert_false(restored.restore(bad), "Invalid coordinate type rejected")
	bad = serialized.duplicate(true)
	bad.template_id = "unknown"
	t.assert_false(restored.restore(bad), "Unknown template rejected")
	document.clear()
	t.assert_eq(document.shapes.size(), 0, "Clear removes all artwork")
	document.undo()
	t.assert_true(document.completion().ready, "Clear is undoable")
	document.set_template("cat")
	t.assert_eq(document.shapes.size(), 0, "Changing template starts new skeleton")
	document.undo()
	t.assert_eq(document.template_id, "robot", "Template change is undoable")
	t.assert_true(document.completion().ready, "Undo template change restores artwork")
	document.redo()
	t.assert_eq(document.template_id, "cat", "Redo reapplies template change")
	for template: Dictionary in Templates.all_templates():
		var sample: Document = Document.new()
		sample.set_template(str(template.id))
		sample.fill_example()
		t.assert_true(sample.completion().ready, "Each example forms a ready articulated character")
		var first_slot: Dictionary = template.parts[0]
		var shape: Dictionary = sample.shape_for_slot(str(first_slot.id))
		sample.select_shape(int(shape.id))
		sample.move_selected(Vector2(400, 400))
		t.assert_false(sample.completion().ready, "Displaced part invalidates readiness")
		t.assert_true(sample.attach_selected(str(first_slot.id)), "Part snaps back onto skeleton")
		t.assert_true(sample.completion().ready, "Snapping restores readiness")
	t.assert_eq(document.add_shape("triangle", Vector2.ZERO, Color.WHITE), -1, "Unsupported free shape rejected")
	t.assert_eq(document.add_shape("square", Vector2(INF, 0), Color.WHITE), -1, "Nonfinite position rejected")
	_test_canvas_input(t)

static func _test_canvas_input(t) -> void:
	var canvas: Workshop = Workshop.new()
	canvas.size = Vector2(700, 650)
	canvas.document = Document.new()
	canvas.select_kind("square")
	# Canvas mouse coordinates must map correctly through responsive centering and scale.
	var antenna: Vector2 = Vector2(0, -153)
	var press: InputEventMouseButton = InputEventMouseButton.new()
	press.button_index = MOUSE_BUTTON_LEFT
	press.pressed = true
	press.position = canvas.character_to_screen(antenna)
	canvas._gui_input(press)
	t.assert_eq(canvas.document.shapes.size(), 1, "Pointer click fills matching skeleton slot")
	t.assert_eq(canvas.document.shapes[0].slot_id, "antenna", "Pointer coordinate conversion hits intended slot")
	var release: InputEventMouseButton = InputEventMouseButton.new()
	release.button_index = MOUSE_BUTTON_LEFT
	release.pressed = false
	release.position = press.position
	canvas._gui_input(release)
	t.assert_eq(canvas.document.shapes.size(), 1, "Release after slot fill does not create an extra shape")
	# Press and drag a painted part: only release commits the command.
	canvas._gui_input(press)
	var history_before: int = canvas.document.command_manager.undo_stack.size()
	var motion: InputEventMouseMotion = InputEventMouseMotion.new()
	motion.position = canvas.character_to_screen(antenna + Vector2(90, 0))
	canvas._gui_input(motion)
	t.assert_eq(canvas.document.command_manager.undo_stack.size(), history_before, "Drag preview does not flood undo history")
	release.position = motion.position
	canvas._gui_input(release)
	t.assert_eq(canvas.document.command_manager.undo_stack.size(), history_before + 1, "One drag creates exactly one command")
	t.assert_eq(canvas.document.get_selected().position, Vector2(90, -152), "Release applies snapped translation")
	canvas.document.undo()
	t.assert_eq(canvas.document.get_selected().position, antenna, "Undo restores the entire pointer drag")
	# Drawing in free space creates only an approved shape; wrong palette choice cannot fill head.
	press.position = canvas.character_to_screen(Vector2(210, 30))
	canvas._gui_input(press)
	release.position = press.position
	canvas._gui_input(release)
	t.assert_eq(canvas.document.shapes.size(), 2, "Clicking free space adds a quadrilateral decoration")
	t.assert_true(Math.matches_kind(canvas.document.get_selected().vertices, "square"), "Decoration obeys palette family")
	press.position = canvas.character_to_screen(Vector2(0, -106))
	canvas._gui_input(press)
	t.assert_eq(canvas.document.shapes.size(), 2, "Mismatched palette click does not fill rectangle head")
	canvas.free()
