class_name TestSpaceHangar
extends RefCounted

const Hangar: GDScript = preload("res://scenes/space/space_hangar.gd")
const Catalog: GDScript = preload("res://scripts/economy/spaceship_catalog.gd")

static func run(t: Node) -> void:
	var state: ConstructionState = ConstructionState.new()
	var hangar: SpaceHangar = Hangar.new()
	hangar.state = state
	hangar.size = Vector2(800, 600)
	var purchases: Array[String] = []
	var launches: Array[bool] = []
	var homes: Array[bool] = []
	var appearances: Array[Dictionary] = []
	var exports: Array[bool] = []
	hangar.purchase_requested.connect(func(id: String): purchases.append(id))
	hangar.appearance_requested.connect(func(data: Dictionary): appearances.append(data))
	hangar.export_requested.connect(func(): exports.append(true))
	hangar.launch_requested.connect(func(): launches.append(true))
	hangar.home_requested.connect(func(): homes.append(true))
	t.add_child(hangar)
	await t.get_tree().process_frame
	t.assert_eq(hangar._slot_picker.item_count, 12, "All twelve required functions are accessible in the hangar")
	t.assert_eq(hangar._variant_buttons.size(), 3, "Three products can be compared for the selected function")
	t.assert_true(hangar._purchase.disabled, "Starting working capital cannot buy a spaceship part")
	t.assert_true(hangar._launch.disabled, "An incomplete ship cannot launch")
	hangar._request_export()
	t.assert_true(exports.is_empty(), "An incomplete ship cannot export a finished PNG")
	hangar._appearance_tab.pressed.emit()
	t.assert_true(hangar._appearance_options.visible and not hangar._shop_options.visible, "The design tab opens the finish and attachment options")
	t.assert_eq(hangar._appearance_pickers.size(), 7, "The hangar exposes a material, two colors, and four attachment locations")
	var initial: Dictionary = state.ship_appearance.duplicate()
	var finish: OptionButton = hangar._appearance_pickers["finish"]
	finish.select(1)
	finish.item_selected.emit(1)
	t.assert_eq(appearances.size(), 1, "Changing a visible choice requests a save")
	t.assert_eq(state.ship_appearance, initial, "Only the application transaction may apply the appearance")
	t.assert_eq(finish.get_selected_metadata(), initial.finish, "An unapplied choice returns to the stored value")
	var applied: Dictionary = state.set_ship_appearance(appearances[0])
	hangar.show_appearance_result(applied)
	t.assert_eq(finish.get_selected_metadata(), "titanium", "A saved finish is restored in the picker")
	t.assert_eq(hangar.canvas._appearance, state.ship_appearance, "The full design preview uses the saved finish")
	t.assert_eq(state.ship_spent(), 0, "Free customization leaves the ship budget untouched")
	hangar._structure_button.pressed.emit()
	t.assert_true(hangar._structure_visible, "The preview can expose internal components")
	hangar._parts_tab.pressed.emit()
	t.assert_true(hangar._shop_options.visible and not hangar._appearance_options.visible, "Players can return to the required part shop")
	hangar._ask_purchase()
	t.assert_false(hangar._confirmation.visible, "An unaffordable selection cannot open a purchase confirmation")
	hangar._select_part("core")
	t.assert_true(hangar._structure_visible, "Selecting an internal device reveals its installed position")
	t.assert_eq(hangar.canvas.selected_part_id, "core", "Selecting a component highlights its actual quadrilateral")
	t.assert_true(hangar._detail.text.contains("마름모"), "Selected part details teach its true shape")
	var before: Dictionary = state.serialize()
	hangar._select_tier(1)
	t.assert_eq(hangar.canvas._preview_id, "core_advanced", "The actual ship previews the selected product")
	t.assert_true(hangar._detail.text.contains("정사각형"), "An alternative product can have a different quadrilateral shape")
	t.assert_true(hangar._detail.text.contains("비행 성능 +2"), "Product comparison explains the performance upgrade")
	hangar._request_launch()
	t.assert_eq(launches.size(), 0, "Disabled launch paths cannot dispatch a transaction")
	t.assert_eq(state.serialize(), before, "Browsing the hangar never mutates the economic model")
	# A price-only receipt is sufficient for this UI fixture. Receipt integrity is
	# exercised by the economy tests; the UI must only emit an approved intent.
	state.art_sales.append({"price": 300000000})
	hangar.refresh()
	hangar._ask_purchase()
	t.assert_true(hangar._confirmation.visible, "Affordable purchases require a second confirmation")
	t.assert_eq(purchases.size(), 0, "Opening the confirmation alone cannot spend money")
	hangar._select_part("nose")
	hangar._confirm_purchase()
	t.assert_eq(purchases, ["core_advanced"], "Confirmation purchases the quoted product even if selection changes")
	hangar._confirm_purchase()
	t.assert_eq(purchases.size(), 1, "Repeated confirmation cannot dispatch a second purchase")
	t.assert_eq(state.purchased_ship_parts.size(), 0, "Purchase intent leaves all model mutations to the saved transaction")
	hangar._ask_purchase()
	state.art_sales.clear()
	hangar.refresh()
	t.assert_true(hangar._confirmation.get_ok_button().disabled, "A stale quote is disabled when funds change")
	hangar._confirm_purchase()
	t.assert_eq(purchases.size(), 1, "An outdated confirmation cannot overspend")
	# The fixture bypasses funding and receipt creation for these UI checks.
	for item: Dictionary in Catalog.all_parts(): state.purchased_ship_parts.append(str(item.id))
	state.art_sales.append({"price": 1300000000})
	hangar.refresh()
	hangar._select_part("hull")
	hangar._select_tier(1)
	t.assert_true(hangar._purchase.text.contains("차액") and not hangar._purchase.disabled, "An equipped part offers a funded upgrade by price difference")
	t.assert_eq(str(state.installed_ship_part("hull").id), "hull", "Trying an upgrade leaves the purchased part in the ledger")
	hangar._ask_purchase()
	t.assert_eq(hangar._pending_price, 4000000, "The confirmation quotes the exact cost difference")
	hangar._confirm_purchase()
	t.assert_eq(purchases, ["core_advanced", "hull_advanced"], "The upgrade emits a single exact product ID")
	state.purchased_ship_parts[0] = "hull_advanced"
	state.launched = true
	hangar.refresh()
	hangar._select_tier(2)
	t.assert_eq(hangar.canvas._preview_id, "hull_elite", "A finished ship can still preview a larger alternative")
	hangar._request_export()
	t.assert_eq(exports.size(), 1, "A complete ship can save its current appearance as a PNG")
	t.assert_eq(hangar.canvas._preview_id, "", "The export clears the unpurchased preview")
	hangar._select_tier(2)
	t.assert_false(hangar._launch.disabled, "A completed ship exposes its departure action")
	t.assert_true(hangar._launch.text.contains("다시"), "A completed homecoming can be replayed without a new charge")
	hangar._request_launch()
	t.assert_true(hangar._launch_panel.visible, "A replay presents the animated homecoming scene")
	t.assert_false(hangar._content.visible, "Purchases are unavailable during the launch animation")
	t.assert_eq(hangar._launch_canvas.purchased_ids.size(), 12, "The launched ship uses all twelve assembled components")
	t.assert_true(hangar._launch_canvas.purchased_ids.has("hull_advanced"), "A replay uses the actual installed variant")
	t.assert_eq(hangar._launch_canvas._appearance, state.ship_appearance, "A replay uses the saved finish and exterior attachments")
	t.assert_eq(hangar._launch_canvas._preview_id, "", "A replay omits unpurchased alternatives")
	hangar._process(4.0)
	t.assert_gt(hangar._launch_canvas.launch_time, 3.0, "The real launch advances beyond its countdown")
	var escape: InputEventKey = InputEventKey.new()
	escape.keycode = KEY_ESCAPE
	escape.pressed = true
	hangar._unhandled_key_input(escape)
	t.assert_true(hangar._launch_done, "Escape reaches the arrival scene without undoing completion")
	t.assert_true(state.launched, "Skipping the animation retains the earned homecoming")
	t.assert_true(hangar._launch_home.visible, "Arrival provides a visible route back to the main page")
	t.assert_eq(purchases.size(), 2, "Replaying the homecoming never purchases anything")
	hangar._launch_home.pressed.emit()
	t.assert_eq(homes.size(), 1, "The arrival screen returns through the normal home signal")
	hangar.cancel_activity()
	t.assert_false(hangar._launch_panel.visible, "Leaving the hangar releases the animation overlay")
	t.assert_false(hangar.is_processing(), "A hidden hangar does not continue animating")
	hangar.free()
	await t.get_tree().process_frame
